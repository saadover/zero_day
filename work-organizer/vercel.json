{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/reminders.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 6 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "claude/*": false
    }
  }
}
